{
  "name": "ALICERCE ERP - MASTER COGNITIVE",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "auth-otp-send",
        "options": {}
      },
      "id": "w1",
      "name": "Login - Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 100]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rh-novo-candidato",
        "options": {}
      },
      "id": "w2",
      "name": "RH - Novo Candidato",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "suprimentos-pedido",
        "options": {}
      },
      "id": "w3",
      "name": "Suprimentos - Novo Pedido",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 500]
    },
    {
      "parameters": {
        "jsCode": "const code = Math.floor(1000 + Math.random() * 9000).toString();\nreturn { \n  telefone: $json.body.telefone, \n  codigo: code \n};"
      },
      "id": "n1",
      "name": "Gera OTP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [300, 100]
    },
    {
      "parameters": {
        "operation": "create",
        "table": "login_otp",
        "columns": "telefone, codigo",
        "values": {
          "telefone": "={{ $json.telefone }}",
          "codigo": "={{ $json.codigo }}"
        }
      },
      "id": "db1",
      "name": "Salva OTP 🔴",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [500, 100],
      "credentials": { "supabaseApi": { "id": "YOUR_ID", "name": "Supabase" } }
    },
    {
      "parameters": {
        "message": "🔒 *Alicerce ERP*\n\nSeu código de acesso é: *{{ $node[\"Gera OTP\"].json[\"codigo\"] }}*",
        "phoneNumber": "={{ $node[\"Gera OTP\"].json[\"telefone\"] }}"
      },
      "id": "wa1",
      "name": "Envia OTP 🔴",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [700, 100],
      "credentials": { "whatsAppApi": { "id": "YOUR_ID", "name": "WhatsApp" } }
    },
    {
      "parameters": {
        "operation": "create",
        "table": "candidatos",
        "columns": "nome, telefone, cargo, unidade_interesse, bairro",
        "values": {
          "nome": "={{ $json.body.nome }}",
          "telefone": "={{ $json.body.telefone }}",
          "cargo": "={{ $json.body.cargo }}",
          "unidade_interesse": "={{ $json.body.unidade_interesse }}",
          "bairro": "={{ $json.body.bairro }}"
        }
      },
      "id": "db2",
      "name": "Salva Candidato 🔴",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [300, 300],
      "credentials": { "supabaseApi": { "id": "YOUR_ID", "name": "Supabase" } }
    },
    {
      "parameters": {
        "message": "👔 *Novo Candidato no Banco de Talentos*\n\n*Nome:* {{ $json.body.nome }}\n*Cargo:* {{ $json.body.cargo }}\n*Telefone:* {{ $json.body.telefone }}\n\nVerifique o Painel RH para triagem.",
        "phoneNumber": "55929XXXXXXXX" 
      },
      "id": "wa2",
      "name": "Avisa RH 🔴",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [500, 300],
      "credentials": { "whatsAppApi": { "id": "YOUR_ID", "name": "WhatsApp" } }
    },
    {
      "parameters": {
        "operation": "create",
        "table": "compras_pedidos",
        "columns": "unidade, secretaria, total_itens, status",
        "values": {
          "unidade": "={{ $json.body.unidade }}",
          "secretaria": "={{ $json.body.secretaria }}",
          "total_itens": "={{ $json.body.itens.length }}",
          "status": "PENDENTE"
        }
      },
      "id": "db3",
      "name": "Cria Pedido 🔴",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [300, 500],
      "credentials": { "supabaseApi": { "id": "YOUR_ID", "name": "Supabase" } }
    },
    {
      "parameters": {
        "jsCode": "// Lógica para gerar corpo de e-mail ou dados de PDF\nreturn { \n  html: `<h1>Pedido de Suprimentos</h1><p>Unidade: ${$json.body.unidade}</p><ul>${$json.body.itens.map(i => `<li>${i.qtd}x ${i.nome}</li>`).join('')}</ul>` \n};"
      },
      "id": "n2",
      "name": "Formata PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [500, 500]
    }
  ],
  "connections": {
    "Login - Webhook": { "main": [[{ "node": "Gera OTP", "type": "main", "index": 0 }]] },
    "Gera OTP": { "main": [[{ "node": "Salva OTP 🔴", "type": "main", "index": 0 }]] },
    "Salva OTP 🔴": { "main": [[{ "node": "Envia OTP 🔴", "type": "main", "index": 0 }]] },
    "RH - Novo Candidato": { "main": [[{ "node": "Salva Candidato 🔴", "type": "main", "index": 0 }]] },
    "Salva Candidato 🔴": { "main": [[{ "node": "Avisa RH 🔴", "type": "main", "index": 0 }]] },
    "Suprimentos - Novo Pedido": { "main": [[{ "node": "Cria Pedido 🔴", "type": "main", "index": 0 }]] },
    "Cria Pedido 🔴": { "main": [[{ "node": "Formata PDF", "type": "main", "index": 0 }]] }
  }
}
