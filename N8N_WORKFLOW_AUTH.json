{
  "name": "Alicerce - Auth WhatsApp OTP",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "auth-otp-send",
        "options": {}
      },
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "auth-otp-send"
    },
    {
      "parameters": {
        "jsCode": "const code = Math.floor(1000 + Math.random() * 9000).toString();\nreturn { \n  telefone: $json.body.telefone, \n  codigo: code \n};"
      },
      "id": "2",
      "name": "Gerar Código",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "create",
        "table": "login_otp",
        "columns": "telefone, codigo",
        "values": {
          "telefone": "={{ $json.telefone }}",
          "codigo": "={{ $json.codigo }}"
        }
      },
      "id": "3",
      "name": "Salvar no Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "supabaseApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Supabase Connection"
        }
      }
    },
    {
      "parameters": {
        "message": "🔒 *Alicerce ERP*\n\nSeu código de acesso é: *{{ $node[\"Gerar Código\"].json[\"codigo\"] }}*\n\nEste código expira em 10 minutos.",
        "phoneNumber": "={{ $node[\"Gerar Código\"].json[\"telefone\"] }}"
      },
      "id": "4",
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [850, 300],
      "credentials": {
        "whatsAppApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "WhatsApp API"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Gerar Código",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gerar Código": {
      "main": [
        [
          {
            "node": "Salvar no Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Salvar no Supabase": {
      "main": [
        [
          {
            "node": "Enviar WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
